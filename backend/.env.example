# Copy to .env locally; never commit real credentials.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:5432/DATABASE?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
SERVER_SEED=replace-with-a-different-long-random-secret
# PGSSL=disable
# PORT=5000

# Optional WebRTC relay using coturn-compatible shared-secret credentials.
# Browser credentials expire after one hour; keep the shared secret private.
# CASINO_TURN_URLS=turn:YOUR_HOST:3478,turns:YOUR_HOST:5349
# CASINO_TURN_SECRET=YOUR_TURN_SHARED_SECRET
